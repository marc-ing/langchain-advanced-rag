# Optional server-side fallback. A browser-provided key takes precedence.
MODEL_API_KEY=

# OpenAI-compatible endpoint used by both Embedding and LLM calls.
API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Values prefilled in the web settings panel.
DEFAULT_EMBEDDING_MODEL=text-embedding-v1
DEFAULT_LLM_MODEL=qwen-plus
